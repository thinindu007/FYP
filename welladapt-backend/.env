# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Privacy Settings
ENABLE_LOGGING=false
DATA_RETENTION_DAYS=0

# Model Configuration (for future ML integration)
MODEL_ENDPOINT=http://localhost:8000
EMOTION_THRESHOLD=0.75
MAX_RESPONSE_TIME=3000


# ==================== DATABASE CONFIGURATION ====================

# MongoDB Connection
# For local MongoDB without authentication:
MONGODB_URI=mongodb://localhost:27017/welladapt

# OR for MongoDB with authentication:
# MONGODB_URI=mongodb://welladapt_user:Rose1023@localhost:27017/welladapt

# Database Options
DB_NAME=welladapt
```

Create `.gitignore`:
```
node_modules/
.env
*.log
.DS_Store